<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bluff Profile Setup</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous">
    <link rel="stylesheet" href="\stylesheets\style.css">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>
<body class="set-profile-body">  
    <div class="set-profile-container">
        <h3 class="profile-text">PROFILE SETUP</h3>
        <form id="profile-form">
            <div>
                <label>Name</label>
                <input type="text" placeholder="Enter your name" id="name" required>
            </div>
            <div>
                <label>Nationality</label>
                <select id="nationality" required>
                    <option value="">Select your nationality</option>
                    {{#each countries}}
                        <option value="{{this}}">{{this}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="gender-box">
                <label>Gender</label>
                <div>
                    <input type="radio" value="Male" name="gender" required>
                    <label>Male</label>
                </div>
                <div>
                    <input type="radio" value="Female" name="gender" required>
                    <label>Female</label>
                </div>
                <div>
                    <input type="radio" value="Other" name="gender" required>
                    <label>Other</label>
                </div>
            </div>

            <button class="set-prof-btn">Create</button>
        </form>
    </div>
    <script src="/javascript/set-profile.js"></script>
</body>
</html>